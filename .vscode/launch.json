{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dtwiz (pick command, subcommand, flags)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "args": "${input:command} ${input:subcommand} ${input:flags}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "dtwiz (free-form args)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "args": "${input:args}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "dtwiz (attach to process)",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickProcess}"
    }
  ],
  "inputs": [
    {
      "id": "command",
      "type": "pickString",
      "description": "dtwiz command",
      "default": "setup",
      "options": [
        "setup",
        "analyze",
        "recommend",
        "status",
        "watch",
        "version",
        "install",
        "update",
        "uninstall"
      ]
    },
    {
      "id": "subcommand",
      "type": "promptString",
      "description": "Subcommand/method, e.g. otel, kubernetes (empty for setup, analyze, recommend, status, watch, version)",
      "default": ""
    },
    {
      "id": "flags",
      "type": "promptString",
      "description": "Flags/args, e.g. --dry-run --experimental --from 1h (may be empty)",
      "default": ""
    },
    {
      "id": "args",
      "type": "promptString",
      "description": "Full dtwiz arguments, e.g. install otel --dry-run --experimental",
      "default": "setup"
    }
  ]
}
